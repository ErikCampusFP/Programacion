
public class Bebida {
	private int precio;
	private String nombre;
	
	
	public Bebida(int precio, String nombre) {
		super();
		this.precio = precio;
		this.nombre = nombre;
	}


	public Bebida(Bebida b1) {
		// TODO Auto-generated constructor stub
	}


